# Gemini API key used by the asynchronous transaction classifier
GEMINI_API_KEY=your_gemini_api_key_here

# Change this before deploying publicly; generate 32+ random bytes
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_MINUTES=720

# Local service URLs (Compose provides these automatically)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/transactions_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Optional published ports
FRONTEND_PORT=5173